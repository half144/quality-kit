{
  "description": "quality-kit: the gate before the agent finishes and the integrity lock guard. Only acts in projects where the setup skill set up the kit.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/quality-kit.mjs\" hook",
            "timeout": 900,
            "statusMessage": "quality-kit: change gate"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/quality-kit.mjs\" hook",
            "timeout": 900,
            "statusMessage": "quality-kit: subagent gate"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/quality-kit.mjs\" hook",
            "timeout": 60
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/quality-kit.mjs\" guard",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
